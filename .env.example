# Copy to .env and edit. All values are optional.

# Require this key in the X-API-Key header (leave empty for local testing)
API_KEY=

# Comma-separated list of websites allowed to call the API from the browser.
# "*" = anyone (fine for development). In production list your domains:
# CORS_ORIGINS=https://myshop.com,https://www.myshop.com
CORS_ORIGINS=*

MAX_UPLOAD_MB=10
RETURN_RAW_TEXT=true

# Visual check with CLIP (~600 MB model). Set false for a lighter/faster server;
# the PayPal text check still runs.
ENABLE_CLASSIFIER=true
MIN_CLASS_SCORE=0.40

OCR_LANGUAGES=en
OCR_GPU=false
MIN_OCR_CONFIDENCE=0.30
MIN_KEYWORD_HITS=2
BLUR_THRESHOLD=40
