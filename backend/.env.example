# Copy to .env (same folder) and change what you need.

# Matches docker-compose.yml in the project root
DATABASE_URL=postgresql+psycopg://khataz:khataz_dev@localhost:5432/khataz

# CHANGE THIS before deploying. Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRE_MINUTES=1440

# Frontend address(es) allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Uploaded screenshots are stored here (private, served only to the two parties)
STORAGE_DIR=storage
MAX_UPLOAD_MB=10

# Screenshot scanner: needs requirements-scanner.txt. If false or not installed, users type the details.
SCANNER_ENABLED=true

# A received amount at least this share of the claimed amount (in USD terms) is accepted automatically
PAYMENT_TOLERANCE=0.95
FX_TIMEOUT_SECONDS=6

# Where the web app runs; used for links in emails
APP_URL=http://localhost:5173

# ---- Email (invites). Leave SMTP_HOST empty to print emails in this terminal instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=<16-letter app password from myaccount.google.com/apppasswords>
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, login + SMTP key from Brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Khataz <you@gmail.com>

# ---- PayPal (sandbox for the hackathon). Leave PAYPAL_CLIENT_ID empty to turn it off.
# developer.paypal.com -> Apps & Credentials -> your sandbox app -> Client ID + Secret
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must match the Return URL in the app's "Log in with PayPal" settings exactly.
# If PayPal won't accept localhost, use https://example.com and paste the link back on your profile.
PAYPAL_REDIRECT_URI=http://localhost:5173/paypal/callback
# How often pending payments are checked against receivers' PayPal (seconds, 0 = only on "Check PayPal now")
PAYPAL_SYNC_SECONDS=120

# ---- "Type an entry" (dashboard). Free AI, tried in order; without keys the built-in reader is used.
# Groq: console.groq.com -> API Keys (no card). Any model from Groq's Models page works.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (backup): openrouter.ai -> Keys; pick a model whose id ends in :free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_TIMEOUT_SECONDS=12
